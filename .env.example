# PetMeta Backend - Örnek Ortam Değişkenleri
#
# Yerel geliştirme için bu dosyayı ".env" olarak kopyalayın ve değerleri
# kendi ortamınıza göre doldurun:
#   cp .env.example .env
#
# Render.com üzerinde bu değişkenler render.yaml veya Dashboard > Environment
# sekmesi üzerinden ayarlanır; .env dosyası production'a YÜKLENMEMELİDİR.

# ---------- Genel ----------
ENVIRONMENT=development
DEBUG=true

# ---------- Veritabanı ----------
# Yerelde SQLite (varsayılan). Render'da otomatik olarak Postgres URL'i enjekte edilir.
DATABASE_URL=sqlite:///./petmeta.db
# Örnek Postgres bağlantısı:
# DATABASE_URL=postgresql://petmeta:sifre@localhost:5432/petmeta

# ---------- JWT / Kimlik Doğrulama ----------
# ÖNEMLİ: Üretimde mutlaka rastgele, uzun ve gizli bir değerle değiştirin.
# Üretebilmek için: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_INSECURE_DEFAULT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- CORS ----------
# Virgülle ayrılmış origin listesi, örn: https://app.petmeta.com,http://localhost:3000
CORS_ALLOW_ORIGINS=*

# ---------- Yapay Zekâ Analizi (Groq) ----------
# https://console.groq.com adresinden alınır. BU ANAHTAR ASLA ANDROID
# UYGULAMASINA GÖMÜLMEMELİ; yalnızca backend ortam değişkeni olarak tutulur.
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-11b-vision-preview
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# ---------- Dosya Yükleme ----------
MAX_UPLOAD_SIZE_MB=8
UPLOAD_DIR=uploads

# ---------- Yapay Zekâ Analizi - Kötüye Kullanım Koruması ----------
# Analiz uç noktası hesap/giriş GEREKTİRMEZ (bkz. routers/analysis.py);
# aynı IP'nin günde en fazla kaç analiz isteği yapabileceğini sınırlar.
# 0 veya negatif: limit devre dışı.
ANALYSIS_DAILY_LIMIT_PER_IP=5

